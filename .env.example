# Turnkey Rail environment variables
#
# Copy this file to backend/.env for LOCAL development.
# In production (Railway), set these in the Railway dashboard.

# ===== Required in production =====
# Railway provides PORT automatically — do not set it on Railway.
# PORT=4000

# Path to a directory that persists across deploys (Railway Volume mount).
# In local dev this defaults to backend/data and is gitignored.
# DATA_DIR=/app/data

# ===== Required in production for safety =====
# Session signing secret. REQUIRED — server will refuse to authenticate users
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates all active sessions (forces re-login).
# SESSION_SECRET=replace-with-a-long-random-hex-string-at-least-16-chars

# Login credentials. If set, the entire app (frontend + API) requires login
# via the in-app login page. Leave UNSET for local dev to run wide open.
#
# Multi-user (recommended): comma-separated user:pass pairs.
# Usernames may not contain ":" or ","; passwords may contain ":" but not ",".
# BASIC_AUTH_USERS=alice:pw1,bob:pw2,jyun:Verygood11$
#
# Single-user legacy form (still supported):
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=change-me-to-something-long-and-random

# ===== Optional =====
# CORS — only matters if frontend is on a different origin than the API.
# When Express serves the built frontend (production), same-origin = no CORS needed.
# CORS_ORIGIN=http://localhost:5173

# Override the SQLite file path. Normally DATA_DIR + /buildcore.db is fine.
# DB_PATH=/app/data/buildcore.db
